# ==============================================
# xinsight 环境变量配置
# 复制此文件为 .env.local 并填入实际密钥
# ==============================================

# 必需：DeepSeek（默认模型）
DEEPSEEK_API_KEY=

# 可选：阿里通义千问
DASHSCOPE_API_KEY=

# 可选：其他 LLM 厂商
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# 可选：Vercel AI Gateway（统一网关，免配各厂商密钥）
AI_GATEWAY_API_KEY=

# 可选：桌面端/移动端 API 地址（静态导出模式使用）
# NEXT_PUBLIC_API_URL=https://your-deployed-api.example.com
