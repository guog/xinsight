# ==============================================
# xinsight 环境变量配置
# 复制此文件为 .env.local 并填入实际密钥
# ==============================================

# === 模型提供商配置 ===
# 启用的提供商（逗号分隔），未配置 API Key 的自动跳过
LLM_PROVIDERS=deepseek,qwen

# DeepSeek V4（flash=快速对话, pro=深度推理）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro

# 阿里云百炼 (Qwen) — 同时用于 TTS/STT 语音服务
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODELS=qwen-max,qwen-plus,qwen-turbo,qwq-max

# === 海外提供商（默认不启用，需在 LLM_PROVIDERS 中添加）===
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o,gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-sonnet-4-20250514

# === 语音配置（TTS / STT）===
# TTS 和 STT 均使用阿里云 DashScope，与 Qwen 共用 DASHSCOPE_API_KEY
# TTS 语音合成
TTS_MODEL=cosyvoice-v1
TTS_VOICE=longxiaochun
# STT 语音识别
STT_MODEL=paraformer-realtime-v2

# === Embedding 模型（可选，未来语义搜索扩展用）===
# EMBEDDING_MODEL=text-embedding-v3

# === 其他 ===
# API Key 加密密钥（32 字节 = 64 字符 hex 字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未设置时使用内置 fallback key（仅限开发环境）
ENCRYPTION_KEY=
# Vercel AI Gateway
# AI_GATEWAY_API_KEY=
# 可选：桌面端/移动端 API 地址（静态导出模式使用）
# NEXT_PUBLIC_API_URL=https://your-deployed-api.example.com
